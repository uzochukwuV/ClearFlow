# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/clearflow

# Redis (for Bull queue)
REDIS_URL=redis://localhost:6379

# Cleanverse API (Identity, Compliance, Fiat Ramp)
CLEANVERSE_API_ID=your_api_id
CLEANVERSE_API_KEY=your_api_key
CLEANVERSE_BASE_URL=https://uatapi.cleanverse.com/api/cooperate
CLEANVERSE_ADMIN_WALLET=0x...

# Circle API (USDC Wallets & Transfers)
CIRCLE_API_KEY=your_circle_api_key
CIRCLE_BASE_URL=https://api.circle.com
CIRCLE_WALLET_SET_ID=your_wallet_set_id
CIRCLE_ENTITY_SECRET=your_entity_secret
CIRCLE_WEBHOOK_SECRET=your_webhook_secret

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_min_32_chars
JWT_EXPIRY=7d
