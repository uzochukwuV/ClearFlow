{
  "name": "clearflow",
  "version": "1.0.0",
  "description": "Purchase Order Financing Backend - Verified Invoice Factoring Protocol",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && tsc",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/uzochukwuV/ClearFlow.git"
  },
  "keywords": [
    "po-financing",
    "trade-finance",
    "defi",
    "rwa"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@circle-fin/developer-controlled-wallets": "^10.8.0",
    "@prisma/client": "^5.22.0",
    "bull": "^4.16.5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "express": "^5.2.1",
    "express-async-handler": "^1.2.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "morgan": "^1.11.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "prisma": "^5.22.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.2.0",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.11",
    "typescript": "^5.7.3"
  }
}
